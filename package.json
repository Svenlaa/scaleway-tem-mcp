{
    "name": "tem-mcp",
    "version": "1.0.0",
    "description": "MCP server for Scaleway Transactional Email (TEM) — send emails from any address @ai.svenlaa.eu",
    "type": "module",
    "bin": {
        "tem-mcp": "./src/index.ts"
    },
    "scripts": {
        "start": "node src/index.ts",
        "dev": "node --watch src/index.ts",
        "test": "node --test test/"
    },
    "keywords": [
        "mcp",
        "scaleway",
        "tem",
        "transactional-email"
    ],
    "author": "Sven Laa",
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.16.1",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=26"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@scaleway/sdk": "^4.2.8",
        "zod": "^4.6.7"
    }
}
